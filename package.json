{
  "name": "ildonodiatena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "db:migrate:local": "wrangler d1 execute ildonodiatena-db --local --file=./db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute ildonodiatena-db --remote --file=./db/schema.sql"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.456.0",
    "next": "15.1.6",
    "react": "^18.3.1",
    "react-day-picker": "^9.4.0",
    "react-dom": "^18.3.1",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  }
}
